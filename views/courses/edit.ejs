<div class="container mt-5">
    <form method="POST" action="/courses/<%= course._id %>/update?_method=PUT" class="p-4 shadow rounded bg-light">
      <h2 class="mb-4 text-center">Modifier le cours</h2>
  
      <div class="mb-3">
        <label for="inputTitle" class="form-label">Titre</label>
        <input
          type="text"
          name="title"
          id="inputTitle"
          class="form-control"
          value="<%= course.title %>"
          placeholder="Titre du cours"
          required
          autofocus
        />
      </div>
  
      <div class="mb-3">
        <label for="inputDescription" class="form-label">Description</label>
        <textarea
          name="description"
          id="inputDescription"
          class="form-control"
          placeholder="Description du cours"
          rows="4"
          required
        ><%= course.description %></textarea>
      </div>
  
      <div class="mb-3">
        <label for="inputMaxStudents" class="form-label">Nombre maximum d'étudiants</label>
        <input
          type="number"
          name="maxStudents"
          id="inputMaxStudents"
          class="form-control"
          value="<%= course.maxStudents %>"
          placeholder="Nombre maximum d'étudiants"
          min="0"
        />
      </div>
  
      <div class="mb-4">
        <label for="inputCost" class="form-label">Coût </label>
        <input
          type="number"
          name="cost"
          id="inputCost"
          class="form-control"
          value="<%= course.cost %>"
          placeholder="Coût du cours"
          min="0"
          step="0.01"
        />
      </div>
  
      <div class="text-center">
        <button type="submit" class="btn btn-success">
          <i class="bi bi-save"></i> Mettre à jour
        </button>
      </div>
    </form>
  </div>

  