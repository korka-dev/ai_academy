<div class="container mt-5">
    <h1 class="mb-4 text-center">Détails du cours: <%= course.title %></h1>
  
    <table class="table table-bordered table-striped">
      <tbody>
        <tr>
          <th scope="row">Titre</th>
          <td><%= course.title %></td>
        </tr>
        <tr>
          <th scope="row">Description</th>
          <td><%= course.description %></td>
        </tr>
        <tr>
          <th scope="row">Nombre maximum d'étudiants</th>
          <td><%= course.maxStudents %></td>
        </tr>
        <tr>
          <th scope="row">Coût</th>
          <td><%= course.cost %> €</td>
        </tr>
      </tbody>
    </table>
  
    <% if (course.students && course.students.length > 0) { %>
      <div class="mt-4">
        <h3 class="mb-3">Étudiants inscrits :</h3>
        <ul class="list-group">
          <% course.students.forEach(student => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <strong><%= student.fullName %></strong>
              <span class="text-muted"><%= student.email %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } else { %>
      <div class="alert alert-warning mt-4">
        Aucun étudiant inscrit pour le moment.
      </div>
    <% } %>
  
    <div class="mt-5 d-flex justify-content-between">
      <a href="/courses" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Tous les cours
      </a>
  
      <div>
        <a href="/courses/<%= course._id %>/edit" class="btn btn-info me-2">
          <i class="bi bi-pencil-square"></i> Modifier
        </a>
  
        <a href="/courses/<%= course._id %>/delete?_method=DELETE"
           class="btn btn-danger"
           onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce cours ?')">
          <i class="bi bi-trash"></i> Supprimer
        </a>
      </div>
    </div>
  </div>

  
  